# Shared cloud PostgreSQL connection used by the deployed CAREERIS server.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long, random production secret. Never expose this in NEXT_PUBLIC_*.
AUTH_SECRET="replace-with-a-long-random-production-secret"

# Optional: enables fresh AI-generated assessment questions.
OPENAI_API_KEY=""
OPENAI_ASSESSMENT_MODEL="gpt-4.1-mini"
